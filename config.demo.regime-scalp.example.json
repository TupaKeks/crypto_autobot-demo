{
  "app": {
    "name": "Crypto Autobot Validated Short Intraday",
    "host": "127.0.0.1",
    "port": 8090,
    "timezone": "Europe/Warsaw",
    "scan_interval_seconds": 5,
    "health_stale_after_seconds": 180,
    "data_dir": "crypto_autobot/data/regime_scalp"
  },
  "market": {
    "base_url": "https://demo-fapi.binance.com",
    "symbols": [
      "AAVEUSDT",
      "ADAUSDT",
      "APTUSDT",
      "CRVUSDT",
      "ETHUSDT",
      "FILUSDT",
      "NEARUSDT",
      "RENDERUSDT",
      "TAOUSDT",
      "XLMUSDT"
    ],
    "interval": "15m",
    "history_limit": 1000
  },
  "broker": {
    "provider": "binance",
    "mode": "demo",
    "recv_window_ms": 5000,
    "quote_asset": "USDT",
    "leverage": 2,
    "margin_type": "ISOLATED",
    "working_type": "MARK_PRICE",
    "price_protect": false
  },
  "strategy": {
    "type": "intraday_regime_pullback",
    "enabled": true,
    "entry_order_type": "limit_retrace",
    "entry_offset_atr": 0.1,
    "entry_expiry_bars": 1,
    "entry_fast_ema": 9,
    "entry_slow_ema": 21,
    "regime_fast_ema": 48,
    "regime_slow_ema": 144,
    "regime_slope_bars": 12,
    "min_regime_slope_percent": 0.02,
    "pullback_lookback": 12,
    "pullback_tolerance_atr": 0.15,
    "long_pullback_rsi": 40.0,
    "short_pullback_rsi": 60.0,
    "long_trigger_rsi": 45.0,
    "short_trigger_rsi": 55.0,
    "max_entry_extension_atr": 1.0,
    "min_confirmation_body_ratio": 0.1,
    "atr_length": 14,
    "adx_length": 14,
    "min_adx": 12.0,
    "rsi_length": 14,
    "long_rsi_min": 20.0,
    "long_rsi_max": 80.0,
    "short_rsi_min": 20.0,
    "short_rsi_max": 80.0,
    "volume_sma_length": 20,
    "min_volume_factor": 0.7,
    "min_atr_percent": 0.04,
    "max_atr_percent": 3.0,
    "band_length": 20,
    "breakout_lookback": 20,
    "stop_atr": 1.8,
    "target_atr": 2.8,
    "target_order_type": "limit",
    "max_holding_bars": 24,
    "cooldown_bars": 3,
    "allow_longs": false,
    "allow_shorts": true,
    "trail_after_r": 99.0,
    "trail_atr": 1.5
  },
  "account": {
    "initial_balance": 10000.0,
    "risk_per_trade_percent": 0.15,
    "max_open_positions": 4,
    "max_daily_trades": 12,
    "max_daily_loss_percent": 1.2,
    "same_candle_exit": "stop_first"
  },
  "notifications": {
    "telegram_enabled": false,
    "token_env": "TELEGRAM_BOT_TOKEN",
    "chat_id_env": "TELEGRAM_CHAT_ID"
  }
