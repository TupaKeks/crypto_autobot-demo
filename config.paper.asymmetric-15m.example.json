{
  "extends": "config.paper.ensemble-15m.example.json",
  "app": {
    "name": "Crypto Autobot Asymmetric 15m Paper",
    "scan_interval_seconds": 15,
    "data_dir": "crypto_autobot/data/asymmetric_15m_paper"
  },
  "market": {
    "symbols": [
      "AAVEUSDT", "ADAUSDT", "APTUSDT", "CRVUSDT", "ETHUSDT",
      "FILUSDT", "NEARUSDT", "RENDERUSDT", "TAOUSDT", "XLMUSDT"
    ]
  },
  "strategy": {
    "allow_longs": true,
    "allow_shorts": true
  },
  "ensemble": {
    "enabled": false
  },
  "account": {
    "risk_per_trade_percent": 0.15,
    "short_risk_per_trade_percent": 0.15,
    "long_risk_per_trade_percent": 0.025,
    "max_open_positions": 4,
    "max_daily_trades": 12,
    "max_daily_loss_percent": 1.2
  },
  "forward_validation": {
    "min_observation_days": 30,
    "min_closed_trades": 100,
    "min_trades_per_day": 3.5,
    "max_trades_per_day": 6.5,
    "min_win_rate_percent": 45.0,
    "min_profit_factor": 1.1,
    "max_drawdown_percent": 10.0,
    "min_return_percent": 0.0,
    "min_nominal_reward_risk": 1.5
  }
}
