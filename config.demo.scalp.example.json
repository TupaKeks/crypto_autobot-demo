{
  "app": {
    "name": "Crypto Autobot Demo Scalping",
    "host": "127.0.0.1",
    "port": 8090,
    "timezone": "Europe/Warsaw",
    "scan_interval_seconds": 30,
    "data_dir": "crypto_autobot/data"
  },
  "market": {
    "base_url": "https://demo-fapi.binance.com",
    "symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
    "interval": "15m",
    "history_limit": 320
  },
  "broker": {
    "mode": "demo",
    "recv_window_ms": 5000,
    "quote_asset": "USDT",
    "leverage": 2,
    "margin_type": "ISOLATED",
    "working_type": "MARK_PRICE",
    "price_protect": false
  },
  "strategy": {
    "enabled": true,
    "fast_ema": 20,
    "slow_ema": 50,
    "min_ema_gap_percent": 0.05,
    "slow_slope_lookback": 3,
    "min_slow_slope_percent": 0.0,
    "atr_length": 14,
    "adx_length": 14,
    "min_adx": 18.0,
    "breakout_lookback": 8,
    "volume_sma_length": 20,
    "min_volume_factor": 1.2,
    "min_atr_percent": 0.08,
    "max_atr_percent": 3.0,
    "stop_atr": 2.0,
    "target_atr": 4.0,
    "trail_after_r": 99.0,
    "trail_atr": 1.2,
    "allow_shorts": true
  },
  "account": {
    "initial_balance": 10000.0,
    "risk_per_trade_percent": 0.1,
    "max_open_positions": 1,
    "max_daily_trades": 12,
    "max_daily_loss_percent": 1.0,
    "same_candle_exit": "stop_first"
  },
  "notifications": {
    "telegram_enabled": false,
    "token_env": "TELEGRAM_BOT_TOKEN",
    "chat_id_env": "TELEGRAM_CHAT_ID"
  }
}
